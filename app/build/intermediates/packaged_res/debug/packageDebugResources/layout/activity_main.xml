<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:padding="16dp">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textSize="20sp"
            android:layout_marginBottom="12dp"/>

        <!-- Recon fields -->
        <EditText
            android:id="@+id/etTokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_tokens"
            android:inputType="text"
            android:autofillHints="username" />

        <EditText
            android:id="@+id/etYears"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_years"
            android:inputType="text"
            android:layout_marginTop="8dp"
            android:autofillHints="postalAddress" />

        <EditText
            android:id="@+id/etSymbols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_symbols"
            android:inputType="text"
            android:layout_marginTop="8dp"
            android:autofillHints="none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etMaxComb"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/hint_max_comb"
                android:inputType="number"
                android:autofillHints="none" />

            <EditText
                android:id="@+id/etMaxLines"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/hint_max_lines"
                android:inputType="number"
                android:layout_marginStart="8dp"
                android:autofillHints="none" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbLeet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply_leetspeak"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/cbReverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/include_reverse"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/generate"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="100" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvFilePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/output"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>